{
  "name": "alfred-tools",
  "version": "0.9.0",
  "private": true,
  "description": "Build and test scripts for the alfred-tools Claude Code plugin. The plugin has no runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=26.13.0" },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "matrix": "node --test --test-concurrency=1 tests/matrix/*.test.ts",
    "lint": "node tests/lint.ts",
    "validate": "node tests/validate-plugin.ts",
    "refresh-pins": "node scripts/refresh-pins.ts",
    "proof": "node tests/proof/proof.ts",
    "typecheck": "tsc -p .",
    "build": "node tests/build.ts",
    "build:check": "node tests/build.ts --check",
    "kit:check": "node .claude/kit/check.mjs"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "typescript": "6.0.3"
  }
}
