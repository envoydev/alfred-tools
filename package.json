{
  "name": "preferred-tools",
  "version": "0.5.0",
  "private": true,
  "description": "Build and test scripts for the preferred-tools Claude Code plugin. The plugin has no runtime dependencies.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.ts",
    "matrix": "node --test --test-concurrency=1 tests/matrix/*.test.ts",
    "lint": "node tests/lint.ts",
    "validate": "node tests/validate-plugin.ts",
    "refresh-pins": "node scripts/refresh-pins.ts",
    "proof": "node tests/proof/proof.ts"
  }
}
